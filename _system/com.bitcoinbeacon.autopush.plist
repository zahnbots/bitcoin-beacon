<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bitcoinbeacon.autopush</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/mzahn/bitcoin beacon/_system/auto-push.sh</string>
  </array>
  <!-- Push-on-completion (since 2026-07-27): the daily run writes
       _system/deploy.trigger as its FINAL step; launchd sees the change and
       pushes immediately. No more fixed 30-min interval — that used to
       snapshot the repo mid-run and publish a half-built edition (new story
       pages, yesterday's homepage). Also fires once at load/login, which
       harmlessly pushes the current state. For a manual push at any time:
       bash "/Users/mzahn/bitcoin beacon/_system/auto-push.sh" -->
  <key>WatchPaths</key>
  <array>
    <string>/Users/mzahn/bitcoin beacon/_system/deploy.trigger</string>
  </array>
  <key>StandardOutPath</key>
  <string>/tmp/bitcoinbeacon-push.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/bitcoinbeacon-push.log</string>
</dict>
</plist>
